# Real credentials belong in the Web console. Never commit .env or .omniharness/.
OMNI_PUBLIC_PORT=8787
OMNI_ENABLE_DEMO=true
# Agent execution remains disabled until all runtime readiness checks pass.
OMNI_ENABLE_AGENT=false
# Tools need the tested independent broker/controller profile; keep disabled until setup passes.
OMNI_ENABLE_TOOLS=false
OMNI_CHECKPOINT_SCHEMA=omniharness_checkpoints
OMNI_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Docker scripts generate the database password in .omniharness/secrets/compose.env.
# Approved local releases are pinned in .omniharness/deployment.env by the deployment script.
