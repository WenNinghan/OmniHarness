+func TestM4FixedSelfProxyReusesRoutesAndAuthentication(t *testing.T) {
+	withTestBinding(t, nil)
+	withRuntimeInit(t, false)
+	withManager(t, true)
+	router := NewRouter("test-only-token")
+	for _, path := range []string{"/proxy/44772/ping", "/proxy/44772/ready"} {
+		if got := doRequest(t, router, http.MethodGet, path, "").Code; got != 200 {
+			t.Fatalf("SDK health path failed: %s %d", path, got)
+		}
+	}
+	for _, path := range []string{"/proxy/44772/omni/profile", "/proxy/44772/command/status/test"} {
+		for _, token := range []string{"", "wrong"} {
+			if got := doRequest(t, router, http.MethodGet, path, token).Code; got != 401 {
+				t.Fatalf("self proxy bypassed authentication: %s %d", path, got)
+			}
+		}
+	}
+	if got := doRequest(t, router, http.MethodPost, "/proxy/44772/command", "").Code; got != 401 {
+		t.Fatalf("proxied command bypassed authentication: %d", got)
+	}
+	profile := doRequest(t, router, http.MethodGet, "/proxy/44772/omni/profile", "test-only-token")
+	if profile.Code != 200 || !strings.Contains(profile.Body.String(), "omniharness-m4-execd-v1") {
+		t.Fatal("authenticated self proxy profile failed")
+	}
+	for _, path := range []string{
+		"/proxy/18080/policy", "/proxy/8080/ping", "/proxy/44772/proxy/44772/ping",
+		"/proxy/44772/internal/init", "/proxy/44772/files/upload", "/proxy/44772/code",
+	} {
+		if got := doRequest(t, router, http.MethodPost, path, "test-only-token").Code; got != 404 {
+			t.Fatalf("self proxy exposed forbidden surface: %s %d", path, got)
+		}
+	}
+}
