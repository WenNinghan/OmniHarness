+func TestM4FixedCommandIdentity(t *testing.T) {
+	zero, user, other := uint32(0), uint32(10001), uint32(10002)
+	for _, pair := range [][2]*uint32{{nil, nil}, {&user, nil}, {nil, &user}, {&user, &user}} {
+		cred, err := buildCredential(pair[0], pair[1])
+		if err != nil || cred == nil || cred.Uid != 10001 || cred.Gid != 10001 || len(cred.Groups) != 0 {
+			t.Fatalf("identity not constrained: credential=%v error=%v", cred, err)
+		}
+	}
+	for _, pair := range [][2]*uint32{{&zero, nil}, {nil, &zero}, {&zero, &zero}, {&other, &user}} {
+		if _, err := buildCredential(pair[0], pair[1]); err == nil {
+			t.Fatal("accepted privileged identity")
+		}
+	}
+}
+
+func TestM4NativeLauncherEnforcesStateAndFailsClosed(t *testing.T) {
+	launcher := os.Getenv("M4_LAUNCHER_BINARY")
+	if launcher == "" {
+		t.Fatal("M4_LAUNCHER_BINARY is required for native enforcement tests")
+	}
+	filter, err := isolation.GenerateSeccompDenyBPF(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	run := func(policy hardeningPolicy) (string, error) {
+		encoded, err := encodePolicy(&policy)
+		if err != nil {
+			return "", err
+		}
+		fd, err := createPolicyMemfd(encoded)
+		if err != nil {
+			return "", err
+		}
+		file := os.NewFile(uintptr(fd), "policy")
+		defer file.Close()
+		cmd := exec.Command(launcher, "3", "--", "/bin/sh", "-c", "echo WORKLOAD_RAN; id -u; cat /proc/self/status")
+		cmd.ExtraFiles = []*os.File{file}
+		output, err := cmd.CombinedOutput()
+		return string(output), err
+	}
+	good := hardeningPolicy{flags: flagUIDDrop | flagCapDrop, uid: 10001, gid: 10001, seccomp: filter}
+	output, err := run(good)
+	if err != nil {
+		t.Fatalf("valid native launch: %v %s", err, output)
+	}
+	for _, expected := range []string{"WORKLOAD_RAN\n10001\n", "CapInh:\t0000000000000000",
+		"CapPrm:\t0000000000000000", "CapEff:\t0000000000000000", "CapBnd:\t0000000000000000",
+		"CapAmb:\t0000000000000000", "NoNewPrivs:\t1"} {
+		if !strings.Contains(output, expected) {
+			t.Fatalf("missing actual enforced state: %s", expected)
+		}
+	}
+	for _, kind := range []string{"root", "no-floor", "invalid-seccomp"} {
+		policy := good
+		switch kind {
+		case "root":
+			policy.uid = 0
+		case "no-floor":
+			policy.flags = 0
+		case "invalid-seccomp":
+			policy.seccomp = []byte{255, 255, 0, 0, 0, 0, 0, 0}
+		}
+		output, err := run(policy)
+		if err == nil || strings.Contains(output, "WORKLOAD_RAN") {
+			t.Fatalf("%s reached workload: %v %s", kind, err, output)
+		}
+	}
+}
+
+func TestM4ReservedEnvironmentRemovedAfterEveryOverlay(t *testing.T) {
+	t.Setenv("EXECD_ACCESS_TOKEN", "test-only-daemon-token")
+	t.Setenv("JUPYTER_TOKEN", "test-only-jupyter-token")
+	file := filepath.Join(t.TempDir(), "envs")
+	if err := os.WriteFile(file, []byte("EXECD_ACCESS_TOKEN=file-value\nNORMAL=file-value\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("EXECD_ENVS", file)
+	cmd, err := prepareCommand(context.Background(), &ExecuteCodeRequest{
+		Argv: []string{"/bin/true"}, Envs: map[string]string{"EXECD_ACCESS_TOKEN": "request-value", "NORMAL": "request-value"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, value := range cmd.Env {
+		if strings.HasPrefix(value, "EXECD_") || strings.HasPrefix(value, "JUPYTER_TOKEN=") {
+			t.Fatal("reserved environment survived")
+		}
+		if value == "NORMAL=request-value" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("ordinary request environment was lost")
+	}
+}
