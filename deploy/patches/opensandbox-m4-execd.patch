+// Copyright 2026 OmniHarness contributors
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"github.com/alibaba/opensandbox/execd/pkg/flag"
+	"github.com/alibaba/opensandbox/execd/pkg/runtime"
+	"testing"
+)
+
+func TestM4StartupRejectsMissingSecurityPrerequisites(t *testing.T) {
+	token, init, dynamic := flag.ServerAccessToken, flag.InitMode, flag.RuntimeInit
+	defer func() { flag.ServerAccessToken, flag.InitMode, flag.RuntimeInit = token, init, dynamic }()
+	flag.ServerAccessToken, flag.InitMode, flag.RuntimeInit = "", true, false
+	if validateM4Startup() == nil {
+		t.Fatal("empty token accepted")
+	}
+	flag.ServerAccessToken, flag.InitMode = "test-only-token", false
+	if validateM4Startup() == nil {
+		t.Fatal("non-init accepted")
+	}
+	flag.InitMode, flag.RuntimeInit = true, true
+	if validateM4Startup() == nil {
+		t.Fatal("runtime rebind mode accepted")
+	}
+}
+
+func TestM4HardeningRejectsEveryDegradedLayer(t *testing.T) {
+	good := runtime.HardeningReport{InitMode: "pid1", SignalShield: true,
+		CapDrop: runtime.LayerState{State: "active"}, Seccomp: runtime.LayerState{State: "active"}}
+	if err := validateM4Hardening(good); err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"init", "shield", "caps", "seccomp"} {
+		report := good
+		switch kind {
+		case "init":
+			report.InitMode = "none"
+		case "shield":
+			report.SignalShield = false
+		case "caps":
+			report.CapDrop.State = "degraded"
+		case "seccomp":
+			report.Seccomp.State = "disabled"
+		}
+		if validateM4Hardening(report) == nil {
+			t.Fatal("degraded state accepted:", kind)
+		}
+	}
+}
