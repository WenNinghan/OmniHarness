+func TestM4CommandOnlyRoutesAndProfileAuthentication(t *testing.T) {
+	withTestBinding(t, nil)
+	withRuntimeInit(t, false)
+	withManager(t, true)
+	router := NewRouter("test-only-token")
+	allowed := map[string]bool{
+		"GET /ping": true, "GET /ready": true, "GET /omni/profile": true,
+		"POST /command": true, "DELETE /command": true,
+		"GET /command/status/:id": true, "GET /command/:id/logs": true,
+	}
+	for _, route := range router.Routes() {
+		if !allowed[route.Method+" "+route.Path] {
+			t.Fatalf("unexpected API surface: %s %s", route.Method, route.Path)
+		}
+	}
+	for _, path := range []string{"/omni/profile", "/command/status/test-id"} {
+		for _, token := range []string{"", "wrong"} {
+			if got := doRequest(t, router, http.MethodGet, path, token).Code; got != 401 {
+				t.Fatalf("unauthenticated route: %s %d", path, got)
+			}
+		}
+	}
+	for _, path := range []string{"/internal/init", "/files/upload", "/session", "/code", "/pty", "/v1/isolated/session"} {
+		if got := doRequest(t, router, http.MethodPost, path, "test-only-token").Code; got != 404 {
+			t.Fatalf("disabled route exposed: %s %d", path, got)
+		}
+	}
+	response := doRequest(t, router, http.MethodGet, "/omni/profile", "test-only-token")
+	if response.Code != 200 || !strings.Contains(response.Body.String(), "omniharness-m4-execd-v1") {
+		t.Fatal("missing authenticated profile")
+	}
+}
