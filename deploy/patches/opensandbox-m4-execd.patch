+func TestM4FixedSelfProxyStreamsWithCorrectStatus(t *testing.T) {
+	withTestBinding(t, nil)
+	withRuntimeInit(t, false)
+	withManager(t, true)
+	router := NewRouter("test-only-token")
+	// Match command SSE's lazy header commit, without starting a workload.
+	router.POST("/m4-test-stream", func(ctx *gin.Context) {
+		ctx.Header("Content-Type", "text/event-stream")
+		_, _ = ctx.Writer.Write([]byte("event: output\ndata: ready\n\n"))
+		ctx.Writer.Flush()
+	})
+	for _, path := range []string{"/m4-test-stream", "/proxy/44772/m4-test-stream"} {
+		response := doRequest(t, router, http.MethodPost, path, "test-only-token")
+		if response.Code != http.StatusOK || !strings.Contains(response.Body.String(), "data: ready") {
+			t.Fatalf("stream failed at %s: status=%d body=%q", path, response.Code, response.Body.String())
+		}
+		if got := doRequest(t, router, http.MethodPost, path, "").Code; got != http.StatusUnauthorized {
+			t.Fatalf("stream bypassed authentication: %s %d", path, got)
+		}
+	}
+	if got := doRequest(t, router, http.MethodPost, "/proxy/44772/not-a-route", "test-only-token").Code; got != http.StatusNotFound {
+		t.Fatalf("missing proxied route should still return 404: %d", got)
+	}
+}
