+// Copyright 2026 The OmniHarness Contributors
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+    "context"
+    "os"
+    "path/filepath"
+    "testing"
+
+    "github.com/alibaba/opensandbox/egress/pkg/dnsproxy"
+    "github.com/stretchr/testify/require"
+)
+
+func TestOmniHarnessShutdownRetainsSharedNamespaceRules(t *testing.T) {
+    // No experimental quarantine owner: this is the ordinary Docker path.
+    dir := t.TempDir()
+    commands := filepath.Join(dir, "commands")
+    for _, name := range []string{"nft", "iptables", "ip6tables"} {
+        require.NoError(t, os.WriteFile(filepath.Join(dir, name),
+            []byte("#!/bin/sh\necho called >> '"+commands+"'\n"), 0700))
+    }
+    t.Setenv("PATH", dir)
+    applier := &quarantineCleanupNft{}
+    ctx, cancel := context.WithCancel(context.Background())
+    cancel()
+    waitForShutdown(ctx, &dnsproxy.Proxy{}, nil, nil, applier, nil, nil)
+    require.False(t, applier.removed, "the still-running workload must retain nft enforcement")
+    _, err := os.Stat(commands)
+    require.True(t, os.IsNotExist(err), "DNS redirect teardown must not widen the same namespace")
+}
